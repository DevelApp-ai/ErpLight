@page "/account/profile"
@using ERP.Host.Models.Auth
@using ERP.Host.Services.Auth
@inject AuthService AuthService
@inject NavigationManager NavigationManager

<PageTitle>Profile</PageTitle>

@if (!AuthService.IsAuthenticated)
{
    <div class="alert alert-warning">
        <p>You need to be logged in to view your profile.</p>
        <p><a href="/account/login">Login</a></p>
    </div>
}
else
{
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow">
                <div class="card-header">
                    <h3 class="card-title text-center">User Profile</h3>
                </div>
                <div class="card-body">
                    @if (userInfo != null)
                    {
                        <div class="row mb-3">
                            <div class="col-md-4">
                                <strong>Username:</strong>
                            </div>
                            <div class="col-md-8">
                                @userInfo.UserName
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-4">
                                <strong>Email:</strong>
                            </div>
                            <div class="col-md-8">
                                @userInfo.Email
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-4">
                                <strong>User ID:</strong>
                            </div>
                            <div class="col-md-8">
                                @userInfo.Id
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-4">
                                <strong>Roles:</strong>
                            </div>
                            <div class="col-md-8">
                                @if (userInfo.Roles.Any())
                                {
                                    @foreach (var role in userInfo.Roles)
                                    {
                                        <span class="badge bg-secondary me-1">@role</span>
                                    }
                                }
                                else
                                {
                                    <span>No roles assigned</span>
                                }
                            </div>
                        </div>

                        <hr />

                        <div class="d-grid gap-2">
                            <button class="btn btn-outline-primary" @onclick="Logout">Logout</button>
                            <button class="btn btn-outline-secondary" @onclick="() => NavigationManager.NavigateTo("/")">Back to Home</button>
                        </div>
                    }
                    else
                    {
                        <div class="text-center">
                            <p>Loading profile...</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    private UserInfo? userInfo;

    protected override async Task OnInitializedAsync()
    {
        if (AuthService.IsAuthenticated)
        {
            userInfo = await AuthService.GetCurrentUserAsync();
        }
    }

    private async Task Logout()
    {
        await AuthService.LogoutAsync();
        await localStorage.RemoveItemAsync("authToken");
        await localStorage.RemoveItemAsync("authTokenExpires");
        NavigationManager.NavigateTo("/", true);
    }
}
